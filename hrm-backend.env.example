# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:4200,http://localhost:6001

# Super Admin User Configuration
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_WORK_EMAIL=hr.admin@company.com
ADMIN_PERSONAL_EMAIL=hr.admin@company.com

# Additional Seed Users Configuration
HR_MANAGER_FIRST_NAME=Alvia
HR_MANAGER_LAST_NAME=Khan
HR_MANAGER_WORK_EMAIL=alvia.khan@company.com
HR_MANAGER_PERSONAL_EMAIL=alvia.khan@company.com

IT_MANAGER_FIRST_NAME=Imran
IT_MANAGER_LAST_NAME=Ali
IT_MANAGER_WORK_EMAIL=imran.ali@company.com
IT_MANAGER_PERSONAL_EMAIL=imran.ali@company.com

ENG_MANAGER_FIRST_NAME=Jawad
ENG_MANAGER_LAST_NAME=Bukhari
ENG_MANAGER_WORK_EMAIL=jawad.bukhari@company.com
ENG_MANAGER_PERSONAL_EMAIL=jawad.bukhari@company.com

NEW_EMPLOYEE_FIRST_NAME=Mubeen
NEW_EMPLOYEE_LAST_NAME=Hussain
NEW_EMPLOYEE_WORK_EMAIL=mubeen.hussain@company.com
NEW_EMPLOYEE_PERSONAL_EMAIL=mubeen.hussain@company.com

# MongoDB Configuration
MONGO_URI=mongodb://root:your_secure_db_password@mongodb:27017/nxt-hrm?authSource=admin
MONGO_URI_TEST=mongodb://root:your_secure_db_password@mongodb:27017/nxt-hrm-test?authSource=admin

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters
JWT_EXPIRES_IN=1d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100000

# Logging
LOG_LEVEL=info

# Express Session Configuration (Used for storing WebAuthn challenges)
EXPRESS_SESSION_SECRET=your_super_secret_session_key_minimum_64_characters

# Email Service Configuration
EMAIL_USER=your_email@company.com
EMAIL_PASS=your_email_app_password

# WebAuthn (Passkey) Configuration
RP_ID=localhost
RP_NAME="NXT HRM"

# Comma-separated list of field 'key' values that can be used as a login identifier.
LOGIN_IDENTIFIERS=work_email,emp_code,personal_email,work_phone,email,empCode

# Frontend Configuration
FRONTEND_URL=http://localhost:4200

# File Serving Configuration
FILE_BASE_URL=http://localhost:5000
ENABLE_STATIC_FILES=false
ENABLE_FILE_MAINTENANCE=true

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
