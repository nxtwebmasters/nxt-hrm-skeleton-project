# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=*

# Super Admin User Configuration
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_WORK_EMAIL=hr.admin@company.com
ADMIN_PERSONAL_EMAIL=hr.admin@company.com

# Additional Seed Users Configuration
HR_MANAGER_FIRST_NAME=Alvia
HR_MANAGER_LAST_NAME=Khan
HR_MANAGER_WORK_EMAIL=alvia.khan@expertflow.com
HR_MANAGER_PERSONAL_EMAIL=alvia.khan@gmail.com

IT_MANAGER_FIRST_NAME=Imran
IT_MANAGER_LAST_NAME=Ali
IT_MANAGER_WORK_EMAIL=imran.ali@expertflow.com
IT_MANAGER_PERSONAL_EMAIL=imran.ali@gmail.com

ENG_MANAGER_FIRST_NAME=Jawad
ENG_MANAGER_LAST_NAME=Bukhari
ENG_MANAGER_WORK_EMAIL=jawad.bukhari@expertflow.com
ENG_MANAGER_PERSONAL_EMAIL=jawad.bukhari@gmail.com

NEW_EMPLOYEE_FIRST_NAME=Mubeen
NEW_EMPLOYEE_LAST_NAME=Hussain
NEW_EMPLOYEE_WORK_EMAIL=mubeen.hussain@expertflow.com
NEW_EMPLOYEE_PERSONAL_EMAIL=mubeen.hussain@gmail.com

# MongoDB Configuration
MONGO_URI=mongodb://root:replace_with_secure_db_password@mongodb:27017/nxt-hrm?authSource=admin
MONGO_URI_TEST=mongodb://root:replace_with_secure_db_password@mongodb:27017/nxt-hrm-test?authSource=admin

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production
JWT_EXPIRES_IN=1d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100000

# Logging
LOG_LEVEL=info
# Express Session Configuration (Used for storing WebAuthn challenges)
# IMPORTANT: For production, generate a very long, strong, and truly random string.
# This should be different from JWT_SECRET.
EXPRESS_SESSION_SECRET=replace_with_a_secure_random_session_secret_for_production
# Email Service Configuration
# For Gmail, you generally need to use an "App Password" if 2-Step Verification is enabled.
# Do NOT use your primary Gmail password directly. Generate an App Password in your Google Account security settings.
EMAIL_USER=your_email@company.com
EMAIL_PASS=your_email_app_password
# WebAuthn (Passkey) Configuration
# RP_ID (Relying Party ID): The domain name of your application.
# For local development, this is typically 'localhost'. For production, it must be your actual domain (e.g., 'yourdomain.com').
RP_ID=localhost
# RP_NAME (Relying Party Name): The human-readable name of your application, displayed to the user during passkey operations.
RP_NAME="NXT HRM"

# Comma-separated list of field 'key' values that can be used as a login identifier.
# These keys must correspond to the keys defined in your 'Employee' form.
LOGIN_IDENTIFIERS=work_email,emp_code,personal_email,work_phone,email,empCode

# Frontend Configuration
# This is the URL where your frontend application is hosted.
FRONTEND_URL=http://localhost:4200

# File Serving Configuration
FILE_BASE_URL=http://localhost:5000
ENABLE_STATIC_FILES=false
ENABLE_FILE_MAINTENANCE=true

# OpenAI API Key
# This key is used to authenticate requests to the OpenAI API.
OPENAI_API_KEY=your_openai_api_key_here